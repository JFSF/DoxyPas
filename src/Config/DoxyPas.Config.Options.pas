    (Name: 'PASCAL_DIALECT';
     Kind: okEnum; OrgKind: okBool; Group: 18;
     Format: ''; Depends: '';
     Default: 'Delphi'; MinVal: 0; MaxVal: 0;
     Values: 'Delphi|FPC';
     Doc: 'The PASCAL_DIALECT tag selects the Object Pascal dialect used when parsing the' + #10 +
      'input files (compiler defines, language mode and keywords).' + #10 +
      'Possible values are: Delphi and FPC.' + #10 +
      'The default value is: Delphi.'),
    (Name: 'PASCAL_PLATFORM';
     Kind: okEnum; OrgKind: okBool; Group: 18;
     Format: ''; Depends: '';
     Default: 'Win64'; MinVal: 0; MaxVal: 0;
     Values: 'Win32|Win64|Linux64|macOS|iOS|Android';
     Doc: 'The PASCAL_PLATFORM tag selects the target platform whose conditional symbols' + #10 +
      '(MSWINDOWS, LINUX, CPUX64, ...) are defined while parsing. Additional symbols' + #10 +
      'can be defined with ef cfg_predefined "PREDEFINED".' + #10 +
      'Possible values are: Win32, Win64, Linux64, macOS, iOS and Android.' + #10 +
      'The default value is: Win64.'),
    (Name: 'PASCAL_UNIT_SCOPES';
     Kind: okList; OrgKind: okBool; Group: 18;
     Format: 'string'; Depends: '';
     Default: ''; MinVal: 0; MaxVal: 0;
     Values: 'System|System.Win|Winapi|Vcl|FMX|Data|Xml|Soap|Web|Posix';
     Doc: 'The PASCAL_UNIT_SCOPES tag lists the unit scope names (the compiler''s' + #10 +
      'UNITSCOPENAME) that are tried in front of a unit name, so that Classes can' + #10 +
      'refer to System.Classes in documentation links and uses clauses.System,' + #10 +
      'System.Win, Winapi, Vcl, FMX, Data, Xml, Soap, Web and Posix.'),
    (Name: 'PASCAL_XMLDOC';
     Kind: okBool; OrgKind: okBool; Group: 18;
     Format: ''; Depends: '';
     Default: '1'; MinVal: 0; MaxVal: 0;
     Values: '';
     Doc: 'If the PASCAL_XMLDOC tag is set to YES then DoxyPas will also interpret XML' + #10 +
      'documentation comments (/// with <summary>, <param>, ...) as used by the' + #10 +
      'Delphi Help Insight.' + #10 +
      'The default value is: YES.'),
    (Name: 'PASCAL_PARSE_DFM';
     Kind: okBool; OrgKind: okBool; Group: 18;
     Format: ''; Depends: '';
     Default: '1'; MinVal: 0; MaxVal: 0;
     Values: '';
     Doc: 'If the PASCAL_PARSE_DFM tag is set to YES then DoxyPas will read .dfm and .fmx' + #10 +
      'files and document the component tree of each form.' + #10 +
      'The default value is: YES.'),
    (Name: 'PASCAL_DFM_PROPERTIES';
     Kind: okBool; OrgKind: okBool; Group: 18;
     Format: ''; Depends: '';
     Default: '1'; MinVal: 0; MaxVal: 0;
     Values: '';
     Doc: 'If the PASCAL_DFM_PROPERTIES tag is set to YES then the page of each form also' + #10 +
      'lists the values of the properties of every component (position, size, fonts,' + #10 +
      'strings, ...); if it is NO only the class, the caption and the event handlers' + #10 +
      'are listed. This tag requires that the tag PASCAL_PARSE_DFM is set to YES.' + #10 +
      'The default value is: YES.'),
    (Name: 'DELPHI_PROJECT';
     Kind: okList; OrgKind: okBool; Group: 18;
     Format: 'file'; Depends: '';
     Default: ''; MinVal: 0; MaxVal: 0;
     Values: '';
     Doc: 'The DELPHI_PROJECT tag can be used to specify .dpr, .dpk, .dproj, .groupproj' + #10 +
      '(the union of the projects it lists) or Lazarus .lpi and .lpk files from which' + #10 +
      'the source files, search paths and conditional defines are taken.')
