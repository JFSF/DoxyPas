    'DOT_EDGE_ATTR', 'DOT_FONTPATH', 'DOT_GRAPH_MAX_NODES', 'DOT_IMAGE_FORMAT', 'DOT_NODE_ATTR', 'DOT_NUM_THREADS',
    'DOT_PATH', 'DOXYFILE_ENCODING', 'ENABLED_SECTIONS', 'ENUM_VALUES_PER_LINE', 'EXAMPLE_PATH', 'EXAMPLE_RECURSIVE',
    'EXCLUDE', 'EXCLUDE_PATTERNS', 'EXCLUDE_SYMBOLS', 'EXCLUDE_SYMLINKS', 'EXTERNAL_TOOL_PATH', 'EXTRACT_ALL',
