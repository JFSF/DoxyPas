unit DoxyPas.Output.Translator;

{ The texts of the generated documentation (OUTPUT_LANGUAGE). English is the key: a text without a translation is
  written in English. Languages: Portuguese, Brazilian, Spanish, French, German. }

interface

type
  TLang = (lgEnglish, lgPortuguese, lgBrazilian, lgSpanish, lgFrench, lgGerman);

/// <summary>Selects the language by its OUTPUT_LANGUAGE name ("Portuguese", ...); unknown names give English.</summary>
procedure SetOutputLanguage(const AName: string);
function OutputLanguage: TLang;

/// <summary>ISO code of the language for the lang attribute of HTML.</summary>
function LanguageIso: string;

/// <summary>The text in the selected language.</summary>
function Tr(const AEnglish: string): string;

/// <summary>"Public" + "Types" -> "Public Types" / "Tipos (visibilidade pública)".</summary>
function TrSection(const AProtection, AKind: string): string;

implementation

uses
  System.SysUtils,
  System.Generics.Collections;

var
  Lang: TLang = lgEnglish;
  Tables: array[TLang] of TDictionary<string, string>;

procedure Add(const AEn, APt, ABr, AEs, AFr, ADe: string);
begin
  Tables[lgPortuguese].Add(AEn, APt);
  if ABr <> '' then Tables[lgBrazilian].Add(AEn, ABr) else Tables[lgBrazilian].Add(AEn, APt);
  Tables[lgSpanish].Add(AEn, AEs);
  Tables[lgFrench].Add(AEn, AFr);
  Tables[lgGerman].Add(AEn, ADe);
end;

