function IsImplemented(const AName: string): Boolean;
var
  Lo, Hi, Mid, Cmp: Integer;
begin
  Lo := 0;
  Hi := High(Names);
  while Lo <= Hi do
  begin
    Mid := (Lo + Hi) div 2;
    Cmp := CompareStr(AName, Names[Mid]);
    if Cmp = 0 then
      Exit(True);
    if Cmp < 0 then
      Hi := Mid - 1
    else
      Lo := Mid + 1;
  end;
  Result := False;
end;

function ImplementedOptions: TArray<string>;
var
  I: Integer;
begin
  SetLength(Result, Length(Names));
  for I := 0 to High(Names) do
    Result[I] := Names[I];
end;

end.