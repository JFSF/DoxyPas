    (Name: 'CASE_SENSE_NAMES';
     Kind: okEnum; OrgKind: okBool; Group: 1;
     Format: ''; Depends: '';
     Default: 'NO'; MinVal: 0; MaxVal: 0;
     Values: 'SYSTEM|NO|YES';
     Doc: 'Pascal identifiers are not case sensitive, so the default is NO: the names of' + #10 +
