program PackResources;

{ Packs files into a Pascal unit so that they are part of the executable on every platform.
  Usage: PackResources [-b64] <output.pas> <unit name> <function name> <file> [<file> ...]

  Text mode (default; UTF-8 files):   function <function name>(const AName: string): string;
  Binary mode (-b64; any files):      function <function name>(const AName: string): TBytes;
                                      function <function name>Text(const AName: string): string;
  AName is the file name (case-insensitive). }

{$APPTYPE CONSOLE}

uses
  System.SysUtils,
  System.Classes,
  System.IOUtils,
  System.NetEncoding;

function Q(const S: string): string;
begin
  Result := '''' + S.Replace('''', '''''') + '''';
end;

procedure Emit(SB: TStringBuilder; const S: string);
begin
  SB.Append(S).Append(#13#10);
end;

var
  Output, UnitName, FuncName: string;
  Files: TArray<string>;
  SB: TStringBuilder;
  I, J, FirstArg: Integer;
  Lines: TArray<string>;
  Line, B64: string;
  Binary: Boolean;
begin
  Binary := (ParamCount > 0) and (ParamStr(1) = '-b64');
  FirstArg := 1;
  if Binary then
    Inc(FirstArg);
  if ParamCount < FirstArg + 3 then
  begin
    Writeln('Usage: PackResources [-b64] <output.pas> <unit name> <function name> <file> [<file> ...]');
    Halt(1);
  end;
  Output := ParamStr(FirstArg);
  UnitName := ParamStr(FirstArg + 1);
  FuncName := ParamStr(FirstArg + 2);
  SetLength(Files, ParamCount - FirstArg - 2);
  for I := FirstArg + 3 to ParamCount do
    Files[I - FirstArg - 3] := ParamStr(I);
  SB := TStringBuilder.Create;
  try
    Emit(SB, 'unit ' + UnitName + ';');
    Emit(SB, '');
    Emit(SB, '{ WARNING: generated by tools\PackResources. Do not edit. }');
    Emit(SB, '');
    Emit(SB, 'interface');
    Emit(SB, '');
    if Binary then
    begin
      Emit(SB, 'uses');
      Emit(SB, '  System.SysUtils;');
      Emit(SB, '');
      Emit(SB, 'function ' + FuncName + '(const AName: string): TBytes;');
      Emit(SB, 'function ' + FuncName + 'Text(const AName: string): string;');
    end
    else
      Emit(SB, 'function ' + FuncName + '(const AName: string): string;');
    Emit(SB, '');
    Emit(SB, 'implementation');
    Emit(SB, '');
    Emit(SB, 'uses');
    if Binary then
      Emit(SB, '  System.NetEncoding;')
    else
      Emit(SB, '  System.SysUtils;');
    Emit(SB, '');
    for I := 0 to High(Files) do
    begin
      Emit(SB, 'function Res' + I.ToString + ': string;');
      Emit(SB, 'var');
      Emit(SB, '  SB: TStringBuilder;');
      Emit(SB, 'begin');
      Emit(SB, '  SB := TStringBuilder.Create;');
      Emit(SB, '  try');
      if Binary then
      begin
        B64 := TNetEncoding.Base64.EncodeBytesToString(TFile.ReadAllBytes(Files[I])).Replace(#13, '').Replace(#10, '');
        J := 1;
        while J <= Length(B64) do
        begin
          Emit(SB, '    SB.Append(' + Q(Copy(B64, J, 800)) + ');');
          Inc(J, 800);
        end;
      end
      else
      begin
        Lines := TFile.ReadAllText(Files[I], TEncoding.UTF8).Replace(#13#10, #10).Split([#10]);
        for J := 0 to High(Lines) do
        begin
          Line := Lines[J];
          // keep every source line below the compiler's limit of 1023 characters
          while Length(Line) > 800 do
          begin
            Emit(SB, '    SB.Append(' + Q(Copy(Line, 1, 800)) + ');');
            Line := Copy(Line, 801, MaxInt);
          end;
          Emit(SB, '    SB.Append(' + Q(Line) + ').Append(#10);');
        end;
      end;
      Emit(SB, '    Result := SB.ToString;');
      Emit(SB, '  finally');
      Emit(SB, '    SB.Free;');
      Emit(SB, '  end;');
      Emit(SB, 'end;');
      Emit(SB, '');
    end;
    if Binary then
    begin
      Emit(SB, 'function ' + FuncName + '(const AName: string): TBytes;');
      Emit(SB, 'begin');
      for I := 0 to High(Files) do
      begin
        Emit(SB, '  if SameText(AName, ' + Q(ExtractFileName(Files[I])) + ') then');
        Emit(SB, '    Exit(TNetEncoding.Base64.DecodeStringToBytes(Res' + I.ToString + '));');
      end;
      Emit(SB, '  raise Exception.CreateFmt(''Unknown resource "%s"'', [AName]);');
      Emit(SB, 'end;');
      Emit(SB, '');
      Emit(SB, 'function ' + FuncName + 'Text(const AName: string): string;');
      Emit(SB, 'begin');
      Emit(SB, '  Result := TEncoding.UTF8.GetString(' + FuncName + '(AName));');
      Emit(SB, 'end;');
    end
    else
    begin
      Emit(SB, 'function ' + FuncName + '(const AName: string): string;');
      Emit(SB, 'begin');
      for I := 0 to High(Files) do
      begin
        Emit(SB, '  if SameText(AName, ' + Q(ExtractFileName(Files[I])) + ') then');
        Emit(SB, '    Exit(Res' + I.ToString + ');');
      end;
      Emit(SB, '  raise Exception.CreateFmt(''Unknown resource "%s"'', [AName]);');
      Emit(SB, 'end;');
    end;
    Emit(SB, '');
    Emit(SB, 'end.');
    TFile.WriteAllText(Output, SB.ToString, TUTF8Encoding.Create(True));
    Writeln(Output, ': ', Length(Files), ' resources');
  finally
    SB.Free;
  end;
end.
