     Default: 'YES'; MinVal: 0; MaxVal: 0;
     Values: 'NO|YES|TEXT|GRAPH|BUILTIN';
     Doc: 'If the CLASS_GRAPH tag is set to YES or GRAPH or BUILTIN then Doxygen will' + #10 +
