program PackResources;

{ Packs text files into a Pascal unit so that they are part of the executable on every platform.
  Usage: PackResources <output.pas> <unit name> <function name> <file> [<file> ...]
  Generates:  function <function name>(const AName: string): string;  // AName = file name, case-insensitive }

{$APPTYPE CONSOLE}

uses
  System.SysUtils,
  System.Classes,
  System.IOUtils;

function Q(const S: string): string;
begin
  Result := '''' + S.Replace('''', '''''') + '''';
end;

var
  Output, UnitName, FuncName: string;
  Files: TArray<string>;
  SB: TStringBuilder;
  I, J, P: Integer;
  Lines: TArray<string>;
  Line: string;
begin
  if ParamCount < 4 then
  begin
    Writeln('Usage: PackResources <output.pas> <unit name> <function name> <file> [<file> ...]');
    Halt(1);
  end;
  Output := ParamStr(1);
  UnitName := ParamStr(2);
  FuncName := ParamStr(3);
  SetLength(Files, ParamCount - 3);
  for I := 4 to ParamCount do
    Files[I - 4] := ParamStr(I);
  SB := TStringBuilder.Create;
  try
    SB.Append('unit ').Append(UnitName).Append(';').Append(#13#10#13#10);
    SB.Append('{ WARNING: generated by tools\PackResources. Do not edit. }').Append(#13#10#13#10);
    SB.Append('interface').Append(#13#10#13#10);
    SB.Append('function ').Append(FuncName).Append('(const AName: string): string;').Append(#13#10#13#10);
    SB.Append('implementation').Append(#13#10#13#10);
    SB.Append('uses').Append(#13#10).Append('  System.SysUtils;').Append(#13#10#13#10);
    for I := 0 to High(Files) do
    begin
      SB.Append('function Res').Append(I).Append(': string;').Append(#13#10);
      SB.Append('var').Append(#13#10).Append('  SB: TStringBuilder;').Append(#13#10);
      SB.Append('begin').Append(#13#10).Append('  SB := TStringBuilder.Create;').Append(#13#10);
      SB.Append('  try').Append(#13#10);
      Lines := TFile.ReadAllText(Files[I], TEncoding.UTF8).Replace(#13#10, #10).Split([#10]);
      for J := 0 to High(Lines) do
      begin
        Line := Lines[J];
        // keep every source line below the compiler's limit of 1023 characters
        while Length(Line) > 800 do
        begin
          P := 800;
          SB.Append('    SB.Append(').Append(Q(Copy(Line, 1, P))).Append(');').Append(#13#10);
          Line := Copy(Line, P + 1, MaxInt);
        end;
        SB.Append('    SB.Append(').Append(Q(Line)).Append(').Append(#10);').Append(#13#10);
      end;
      SB.Append('    Result := SB.ToString;').Append(#13#10);
      SB.Append('  finally').Append(#13#10).Append('    SB.Free;').Append(#13#10).Append('  end;').Append(#13#10);
      SB.Append('end;').Append(#13#10#13#10);
    end;
    SB.Append('function ').Append(FuncName).Append('(const AName: string): string;').Append(#13#10);
    SB.Append('begin').Append(#13#10);
    for I := 0 to High(Files) do
    begin
      SB.Append('  if SameText(AName, ').Append(Q(ExtractFileName(Files[I]))).Append(') then').Append(#13#10);
      SB.Append('    Exit(Res').Append(I).Append(');').Append(#13#10);
    end;
    SB.Append('  raise Exception.CreateFmt(''Unknown resource "%s"'', [AName]);').Append(#13#10);
    SB.Append('end;').Append(#13#10#13#10).Append('end.').Append(#13#10);
    TFile.WriteAllText(Output, SB.ToString, TUTF8Encoding.Create(True));
    Writeln(Output, ': ', Length(Files), ' resources');
  finally
    SB.Free;
  end;
end.
