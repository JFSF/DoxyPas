    'GENERATE_DEPRECATEDLIST', 'GENERATE_HTML', 'GENERATE_HTMLHELP', 'GENERATE_LATEX', 'GENERATE_LEGEND',
    'GENERATE_SQLITE3', 'GENERATE_TAGFILE', 'GENERATE_TESTLIST', 'GENERATE_TODOLIST', 'GENERATE_TREEVIEW',
    'GENERATE_XML', 'GROUP_NESTED_COMPOUNDS', 'HAVE_DOT', 'HHC_LOCATION', 'HIDE_COMPOUND_REFERENCE',
