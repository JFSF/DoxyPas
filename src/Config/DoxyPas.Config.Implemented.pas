    'GENERATE_SQLITE3', 'GENERATE_TAGFILE', 'GENERATE_TESTLIST', 'GENERATE_TODOLIST', 'GENERATE_TREEVIEW',
    'GENERATE_XML', 'HAVE_DOT', 'HHC_LOCATION', 'HIDE_UNDOC_CLASSES', 'HIDE_UNDOC_MEMBERS', 'HTML_CODE_FOLDING',
    'HTML_COLORSTYLE', 'HTML_COLORSTYLE_GAMMA', 'HTML_COLORSTYLE_HUE', 'HTML_COLORSTYLE_SAT', 'HTML_COPY_CLIPBOARD',
    'HTML_DYNAMIC_MENUS', 'HTML_DYNAMIC_SECTIONS', 'HTML_EXTRA_FILES', 'HTML_EXTRA_STYLESHEET',
    'HTML_FILE_EXTENSION', 'HTML_FOOTER', 'HTML_HEADER', 'HTML_OUTPUT', 'HTML_STYLESHEET', 'IGNORE_PREFIX',
    'IMAGE_PATH', 'INCLUDED_BY_GRAPH', 'INCLUDE_GRAPH', 'INCLUDE_PATH', 'INHERIT_DOCS', 'INLINE_INFO',
