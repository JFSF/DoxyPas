procedure SetOutputLanguage(const AName: string);
begin
  if SameText(AName, 'Portuguese') then Lang := lgPortuguese
  else if SameText(AName, 'Brazilian') then Lang := lgBrazilian
  else if SameText(AName, 'Spanish') then Lang := lgSpanish
  else if SameText(AName, 'French') then Lang := lgFrench
  else if SameText(AName, 'German') then Lang := lgGerman
  else Lang := lgEnglish;
end;

function OutputLanguage: TLang;
begin
  Result := Lang;
end;

function LanguageIso: string;
const
  Codes: array[TLang] of string = ('en', 'pt', 'pt-BR', 'es', 'fr', 'de');
begin
  Result := Codes[Lang];
end;

function Tr(const AEnglish: string): string;
begin
  if (Lang = lgEnglish) or not Tables[Lang].TryGetValue(AEnglish, Result) then
    Result := AEnglish;
end;

function TrSection(const AProtection, AKind: string): string;
begin
  if Lang = lgEnglish then
  begin
    if AKind.StartsWith('Static ') then
      Result := 'Static ' + AProtection + ' ' + Copy(AKind, 8, MaxInt)
    else
      Result := AProtection + ' ' + AKind;
  end
  else
    Result := Tr(AKind) + ' (' + Tr(AProtection) + ')';
end;

var
  L: TLang;

initialization
  for L := Low(TLang) to High(TLang) do
    Tables[L] := TDictionary<string, string>.Create;
  Fill;

finalization
  for L := Low(TLang) to High(TLang) do
    Tables[L].Free;

end.
