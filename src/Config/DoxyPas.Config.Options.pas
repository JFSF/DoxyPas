    (Name: 'UML_LIMIT_NUM_FIELDS';
     Kind: okInt; OrgKind: okBool; Group: 17;
     Format: ''; Depends: 'UML_LOOK';
     Default: '10'; MinVal: 0; MaxVal: 100;
     Values: '';
     Doc: 'If the UML_LOOK tag is enabled, the fields and methods are shown inside the' + #10 +
